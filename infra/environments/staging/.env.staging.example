# ─────────────────────────────────────────────────────────────────────────────
# Rentars Staging Environment — Non-secret configuration overrides
#
# Copy this file to .env.staging and fill in the SECRET_* placeholders.
# The actual secret values live in your secrets provider (AWS Secrets Manager,
# GitHub Actions Secrets, Fly.io Secrets, etc.) — see secrets.reference.md.
#
# This file IS committed to the repository because it contains no real secrets.
# .env.staging (the populated file) is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Images (override to pull pre-built images from a registry) ────────────────
BACKEND_IMAGE=rentars-backend:staging
FRONTEND_IMAGE=rentars-web:staging

# ── Backend: server ───────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
HSTS_ENABLED=true

# ── Backend: Supabase ─────────────────────────────────────────────────────────
# Staging uses a dedicated Supabase project (separate from production).
SUPABASE_URL=https://<staging-project-id>.supabase.co
# SECRET — value in secrets provider key: RENTARS_STAGING_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=<from-secrets-provider>

# ── Backend: auth ─────────────────────────────────────────────────────────────
# SECRET — value in secrets provider key: RENTARS_STAGING_JWT_SECRET
JWT_SECRET=<from-secrets-provider>

# ── Backend: CORS ─────────────────────────────────────────────────────────────
CORS_ORIGIN=https://staging.rentars.app

# ── Backend: Redis ────────────────────────────────────────────────────────────
# Password for the in-stack Redis instance.
# SECRET — value in secrets provider key: RENTARS_STAGING_REDIS_PASSWORD
REDIS_PASSWORD=<from-secrets-provider>

# ── Backend: Stellar ─────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PROPERTY_LISTING_CONTRACT_ID=<staging-property-listing-contract-id>
BOOKING_CONTRACT_ID=<staging-booking-contract-id>

# ── Backend: Trustless Work ───────────────────────────────────────────────────
TRUSTLESS_WORK_API_URL=https://sandbox.trustlesswork.com
# SECRET — value in secrets provider key: RENTARS_STAGING_TRUSTLESS_WORK_API_KEY
TRUSTLESS_WORK_API_KEY=<from-secrets-provider>

# ── Backend: email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<staging-smtp-user>
# SECRET — value in secrets provider key: RENTARS_STAGING_SMTP_PASS
SMTP_PASS=<from-secrets-provider>
EMAIL_FROM=Rentars Staging <no-reply@staging.rentars.app>

# ── Backend: hCaptcha ─────────────────────────────────────────────────────────
HCAPTCHA_ENABLED=true
# SECRET — value in secrets provider key: RENTARS_STAGING_HCAPTCHA_SECRET_KEY
HCAPTCHA_SECRET_KEY=<from-secrets-provider>

# ── Backend: observability ────────────────────────────────────────────────────
# SECRET — value in secrets provider key: RENTARS_STAGING_METRICS_TOKEN
METRICS_TOKEN=<from-secrets-provider>

# ── Backend: data retention ───────────────────────────────────────────────────
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=500
RETENTION_RUN_ON_STARTUP=false

# ── Frontend: public vars (baked into JS bundle at build time) ────────────────
NEXT_PUBLIC_API_URL=https://api.staging.rentars.app
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_PASSKEY_RP_ID=staging.rentars.app
NEXT_PUBLIC_PASSKEY_RP_NAME=Rentars Staging
NEXT_PUBLIC_PASSKEY_ORIGIN=https://staging.rentars.app

# ── Nginx: TLS certificate path on the host ──────────────────────────────────
TLS_CERT_PATH=/etc/letsencrypt/live/staging.rentars.app
