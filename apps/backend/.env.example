# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Authentication
# Must be a strong random secret (min 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_min_32_chars
# Access tokens expire in 15 minutes. Refresh tokens expire in 7 days.
# POST /auth/refresh with { refreshToken } to obtain new tokens.
# POST /auth/logout  with { refreshToken } (+ Bearer token) to revoke both.

# CORS — comma-separated list of allowed origins (no wildcards — credentialed requests require explicit origins)
# Example for production: CORS_ORIGIN=https://app.rentars.com,https://www.rentars.com
CORS_ORIGIN=http://localhost:3001

# Redis
REDIS_URL=redis://localhost:6379

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Contract IDs (set after deployment)
PROPERTY_LISTING_CONTRACT_ID=your_property_listing_contract_id
BOOKING_CONTRACT_ID=your_booking_contract_id

# TrustlessWork escrow API
TRUSTLESS_WORK_API_URL=https://api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=your_trustless_work_api_key

# Redis
REDIS_URL=redis://localhost:6379

# Geocoding (optional — defaults to OpenStreetMap Nominatim when not set)
GEOCODING_API_KEY=your_geocoding_api_key

# hCaptcha bot protection
# Get keys at https://dashboard.hcaptcha.com/
# Set HCAPTCHA_ENABLED=false to bypass verification in local/dev/CI environments
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key
HCAPTCHA_ENABLED=true

# Body size limits
# Maximum size for JSON request bodies (default: 1mb).
# Use Express body-parser format: "1mb", "512kb", "2mb", etc.
# Multipart/upload routes are governed by multer, not this value.
JSON_BODY_LIMIT=1mb

# ── Observability ──────────────────────────────────────────────────────────────

# Minimum log level written to stdout: debug | info | warn | error (default: info)
# Set to "debug" locally to see all request details.
# Use "warn" or "error" in high-traffic production to reduce log volume.
LOG_LEVEL=info

# Bearer token required to scrape the /metrics endpoint from outside localhost.
# When unset, /metrics is restricted to 127.0.0.1 / ::1 only.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=

# ── Security headers ───────────────────────────────────────────────────────────

# Set to "true" to enable HSTS (Strict-Transport-Security) outside production.
# Useful for staging environments that sit behind a TLS-terminating load balancer.
# WARNING: do NOT set this in local development — HSTS on HTTP breaks browsers.
HSTS_ENABLED=false

# Email (optional — transactional emails via SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=Rentars <no-reply@rentars.app>

# Booking reminders scheduler
# Hours before check-in to send the reminder (default: 24)
REMINDER_CHECKIN_HOURS=24
# Hours before check-out to send the reminder (default: 12)
REMINDER_CHECKOUT_HOURS=12
# How often the reminder job runs, in hours (default: 1)
REMINDER_INTERVAL_HOURS=1

# ── Cancellation refund policy ──────────────────────────────────────────────
# Controls how much of a booking's total is refunded when the tenant cancels,
# based on the time remaining until check-in.
#   FULL    — cancellation >= REFUND_FULL_REFUND_HOURS before check-in → 100% refund
#   PARTIAL — between REFUND_NO_REFUND_HOURS and REFUND_FULL_REFUND_HOURS   → REFUND_PARTIAL_PCT
#   NONE    — cancellation < REFUND_NO_REFUND_HOURS before check-in         → no refund
# Leave unset to use the defaults (168h / 48h / 0.5).
REFUND_FULL_REFUND_HOURS=168
REFUND_NO_REFUND_HOURS=48
REFUND_PARTIAL_PCT=0.5

# ── Data retention ─────────────────────────────────────────────────────────────
# Controls how long each category of ephemeral data is kept before the
# scheduled cleanup job removes it.  The cleanup runs every
# RETENTION_INTERVAL_HOURS (default: 24 h).
#
# A dry-run preview always fires 10 s after startup and logs what WOULD be
# deleted without touching any data.  Set RETENTION_RUN_ON_STARTUP=true to
# also run a live sweep 60 s after startup (useful post-policy-change deploys).
#
# NEVER reduce windows below your legal/compliance minimums.  Financial records
# (confirmed payments, completed bookings with escrow_id) and audit_logs are
# NEVER deleted by these jobs regardless of the settings below.

# How often the retention sweep runs (hours). Default: 24
RETENTION_INTERVAL_HOURS=24

# Max rows deleted per table per run. Lower on busy DBs. Default: 500
RETENTION_BATCH_SIZE=500

# Run a live cleanup 60 s after startup (in addition to the always-on dry-run preview).
RETENTION_RUN_ON_STARTUP=false

# Expired wallet challenge tokens (hours after expiry). Default: 1
RETENTION_WALLET_CHALLENGES_HOURS=1

# Expired/consumed password reset tokens (days). Default: 7
RETENTION_PASSWORD_RESET_TOKENS_DAYS=7

# Blockchain operation log rows (days). Default: 90
RETENTION_BLOCKCHAIN_LOGS_DAYS=90

# Blockchain→DB sync log rows (days). Default: 30
RETENTION_SYNC_LOG_DAYS=30

# Read in-app notification records (days). Default: 90
RETENTION_NOTIFICATIONS_READ_DAYS=90

# Unread in-app notification records (days). Default: 180
RETENTION_NOTIFICATIONS_UNREAD_DAYS=180

# Search analytics query records (days). Default: 365
RETENTION_SEARCH_ANALYTICS_DAYS=365

# Deduplicated property view rows (days). Default: 90
RETENTION_PROPERTY_VIEWS_DAYS=90

# Failed/timed-out payment intents with no active dispute (days). Default: 90
RETENTION_PAYMENTS_FAILED_DAYS=90

# Soft-deleted properties with no active dispute (days). Default: 180
RETENTION_SOFT_DELETED_PROPERTIES_DAYS=180

# Completed/cancelled account-deletion request records (days). Default: 30
RETENTION_ACCOUNT_DELETIONS_CLOSED_DAYS=30
